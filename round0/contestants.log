Claims from claim(string)

import spacy
nlp_claims = spacy.load("en_core_web_lg")
doc_claims = nlp_claims(claims)
claims_list = []
for sent in doc_claims.sents:
    if "CLAIMS" in sent.text:
        str = sent.text
        claims_list.append(str)
claimant = ""
for i in range(len(claims_list)):
    str = claims_list[i]
    x = str.split("CLAIMS")
    l = len(x)
    if "CLAIMANT" in x[0]:
        claimant = x[0].split("CLAIMANT")[1]
    for j in range(l):
        if j != 0 and j != 1 and j!=2:
            claimei = "value of claims claim no. " +str(j-2) + " = " + x[j]
"claims_list: " +str(claims_list)
"claims: " +str(claimei)
"claimant: " +str(claimant)

